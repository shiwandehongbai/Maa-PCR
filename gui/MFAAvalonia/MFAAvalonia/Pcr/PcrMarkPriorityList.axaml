<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Class="MFAAvalonia.Pcr.PcrMarkPriorityList">
 <UserControl.Styles>
  <Style Selector="Border.MarkChip">
   <Setter Property="Padding" Value="8,3" />
   <Setter Property="CornerRadius" Value="13" />
   <Setter Property="Background" Value="#14000000" />
   <Setter Property="BorderThickness" Value="1" />
   <Setter Property="BorderBrush" Value="#22000000" />
   <Setter Property="Cursor" Value="SizeAll" />
   <Setter Property="Margin" Value="0,0,6,0" />
   <Setter Property="MinHeight" Value="28" />
  </Style>
  <Style Selector="Border.MarkChip.enabled">
   <Setter Property="Background" Value="#1E000000" />
   <Setter Property="BorderBrush" Value="{DynamicResource SukiPrimaryColor}" />
  </Style>
  <Style Selector="Border.MarkChip.disabled">
   <Setter Property="Opacity" Value="0.45" />
   <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="Border.MarkChip.dragging">
   <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="Border.MarkChipBadge">
   <Setter Property="CornerRadius" Value="7" />
   <Setter Property="Padding" Value="4,0" />
   <Setter Property="Background" Value="#40000000" />
   <Setter Property="Margin" Value="3,0,0,0" />
   <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
 </UserControl.Styles>
 <StackPanel Name="Root" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
  <CheckBox Name="EnableToggle" Content="启用自定义" VerticalAlignment="Center"
            AutomationProperties.Name="启用自定义印记优先级"
            ToolTip.Tip="勾选后五个印记块按当前顺序参与优先级加成；取消勾选时按内置策略选择遗物。" />
  <StackPanel Name="ChipHost" Orientation="Horizontal" VerticalAlignment="Center" />
 </StackPanel>
</UserControl>
