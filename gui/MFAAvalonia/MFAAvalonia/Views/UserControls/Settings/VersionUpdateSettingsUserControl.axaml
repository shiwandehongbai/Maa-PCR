<UserControl
    d:DesignHeight="450" d:DesignWidth="800" mc:Ignorable="d"
    x:Class="MFAAvalonia.Views.UserControls.Settings.VersionUpdateSettingsUserControl"
    x:DataType="settings:VersionUpdateSettingsUserControlModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="clr-namespace:MFAAvalonia.ViewModels.UsersControls.Settings"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent.Markup;assembly=FluentIcons.Avalonia.Fluent">
    <StackPanel Spacing="20" Margin="0,8">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="12">
            <TextBlock Text="Maa-PCR" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding MfaVersion}" PointerPressed="CopyVersion"
                       Cursor="Hand" ToolTip.Tip="复制版本" TextWrapping="Wrap" MaxWidth="360" />
            <TextBlock Grid.Row="1" Text="MaaFramework" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MaaFwVersion}" />
        </Grid>
        <Separator />
        <DockPanel>
            <ToggleSwitch DockPanel.Dock="Right" Classes="Switch" IsChecked="{Binding PcrCheckStableUpdates}" />
            <TextBlock Text="启动时检查稳定版" VerticalAlignment="Center" />
        </DockPanel>
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
            <TextBlock Text="GitHub 稳定版更新" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding CheckPcrUpdateCommand}" IsEnabled="{Binding PcrCanCheck}"
                        Content="检查更新"
                        Height="40" ToolTip.Tip="检查 Maa-PCR 更新" />
                <Button Command="{Binding InstallPcrUpdateCommand}" IsEnabled="{Binding PcrCanInstallOnline}"
                        Content="下载并安装"
                        Height="40" ToolTip.Tip="从 GitHub 下载并安装稳定版" />
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding PcrUpdateStatus}" TextWrapping="Wrap" />
            <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" IsVisible="{Binding PcrUpdateDownloading}">
                <ProgressBar Value="{Binding PcrUpdateProgress}" Maximum="100" Height="10" VerticalAlignment="Center" />
                <Button Grid.Column="1" Command="{Binding CancelPcrDownloadCommand}" Margin="8,0,0,0"
                        Content="{fluent:FluentIcon Icon=Dismiss, IconSize=Size16}"
                        Width="40" Height="40" Padding="0" ToolTip.Tip="取消下载" />
            </Grid>
        </Grid>
        <DockPanel>
            <Button DockPanel.Dock="Right" Command="{Binding UpdateResourceFromLocalPackageCommand}"
                    IsEnabled="{Binding PcrCanInstall}" Height="40"
                    Content="导入更新包" ToolTip.Tip="选择 Maa-PCR 完整运行包或补丁 ZIP" />
            <TextBlock Text="离线更新包" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock Text="支持完整运行包或匹配当前版本的补丁 ZIP，也可拖入主窗口。请勿解压覆盖安装目录。"
                   TextWrapping="Wrap" FontSize="12" />
        <DockPanel IsVisible="{Binding PcrRecoveryRequired}">
            <Button DockPanel.Dock="Right" Command="{Binding RecoverPcrUpdateCommand}"
                    IsEnabled="{Binding PcrCanInstall}" Width="40" Height="40" Padding="0"
                    Content="{fluent:FluentIcon Icon=ArrowUndo, IconSize=Size16}" ToolTip.Tip="恢复上次中断的更新" />
            <TextBlock Text="恢复中断更新" VerticalAlignment="Center" />
        </DockPanel>
        <Separator />
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="12" ColumnSpacing="20">
            <TextBlock Text="更新代理" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding ProxyModeList}" DisplayMemberBinding="{Binding Name}"
                      SelectedValueBinding="{Binding Other}" SelectedValue="{Binding ProxyMode}"
                      IsEnabled="{Binding PcrCanCheck}" HorizontalAlignment="Stretch" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ProxyAddress}" Watermark="&lt;IP&gt;:&lt;Port&gt;"
                     IsEnabled="{Binding IsCustomProxy}" HorizontalAlignment="Stretch" />
        </Grid>
        <TextBlock Text="仅影响在线更新检查与下载；本地校验、安装和恢复不联网。"
                   TextWrapping="Wrap" FontSize="12" />
    </StackPanel>
</UserControl>
