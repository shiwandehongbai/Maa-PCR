<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <PcrCoreDirectory Condition="'$(PcrCoreDirectory)' == ''">../bin/x64/Release</PcrCoreDirectory>
    <PcrNativeDirectory Condition="'$(PcrNativeDirectory)' == ''">$(PcrCoreDirectory)/runtimes/win-x64/native</PcrNativeDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(PcrCoreDirectory)/*.dll" />
    <Content Include="$(PcrNativeDirectory)/*.dll" Link="runtimes/win-x64/native/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PcrCoreDirectory)/libSkiaSharp.dll;$(PcrCoreDirectory)/libHarfBuzzSharp.dll;$(PcrCoreDirectory)/av_libglesv2.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
